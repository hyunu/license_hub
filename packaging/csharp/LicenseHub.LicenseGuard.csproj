<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>LicenseHub.LicenseGuard</PackageId>
    <Version>0.1.0</Version>
    <Description>LicenseGuard verification binding for licensehub-core (C ABI)</Description>
    <Authors>LicenseHub</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- bindings/csharp/LicenseGuard.cs 를 패키지 라이브러리 소스로 사용 -->
  <ItemGroup>
    <Compile Include="../../bindings/csharp/LicenseGuard.cs" />
  </ItemGroup>

  <!-- 플랫폼별 네이티브 라이브러리를 NuGet runtimes/ 레이아웃으로 포함.
       runtimes/ 는 packaging/package.sh 가 core/dist 에서 스테이징한다. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="runtimes/**" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>