# LicenseHub 웹 백엔드 설정 예제

# 바인딩 주소/포트
BIND_ADDR=127.0.0.1:8080

# SQLite DB 파일 경로
LICENSEHUB_DB=data/licensehub.db

# 프론트엔드 빌드 산출물 경로 (백엔드가 정적 파일을 서빙)
FRONTEND_DIST=../frontend/dist

# 인증서 서명키 (64자 hex, 32바이트). 미설정 시 임시 키 생성(개발 전용).
# 운영에서는 반드시 설정해야 재시작 후에도 인증서가 검증된다.
LICENSEHUB_SIGNING_KEY=

# L2/L3 인증서의 서버 검증 URL
LICENSEHUB_VERIFY_URL=http://127.0.0.1:8080/api/verify

# 초기 관리자 계정
LICENSEHUB_ADMIN_USER=admin
LICENSEHUB_ADMIN_PASSWORD=admin123

# ---- GitHub App 연동 (선택) ----
# GitHub Repository 형식: owner/repo
GITHUB_REPO=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# GitHub App Private Key PEM (내용 또는 경로)
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=