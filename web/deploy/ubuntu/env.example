# LicenseHub 백엔드 환경 설정 (Ubuntu 배포용)
# /opt/licensehub/.env 에 저장

# 공개 HTTPS URL (Caddy+DuckDNS / Tailscale Funnel / Cloudflare Tunnel 중 택1).
# 프론트·L2/L3 클라이언트가 접근하므로 반드시 공개 HTTPS 주소여야 한다.
# 도메인을 사지 않아도 됨:
#   - sslip.io(무계정):  https://<공인IP>.sslip.io
#   - DuckDNS(무료):     https://licensehub.duckdns.org
PUBLIC_URL=https://146.56.111.99.sslip.io

# 0.0.0.0 + VCN 인바운드 8080 미오픈 → Funnel/리버스프록시로만 공개 접근
BIND_ADDR=0.0.0.0:8080
LICENSEHUB_DB=/opt/licensehub/data/licensehub.db
FRONTEND_DIST=/opt/licensehub/frontend

# 필수: 64자 hex 개인키 (openssl rand -hex 32)
# 한 번 생성하면 절대 변경하지 말 것 — 변경 시 기존 인증서 서명이 무효가 된다.
LICENSEHUB_SIGNING_KEY=

# L2/L3 서버 검증 URL: 반드시 실제 배포된 공개 HTTPS 주소를 사용.
# 도메인(Caddy/DuckDNS 등) 설정을 먼저 완료한 뒤 입력해야 인증서에 올바른
# 주소가 박힌다.
LICENSEHUB_VERIFY_URL=$PUBLIC_URL/api/verify

# 관리자 계정
LICENSEHUB_ADMIN_USER=admin
LICENSEHUB_ADMIN_PASSWORD=

# GitHub App 연동 (선택) — 또는 GITHUB_PAT(PAT) 중 하나
#GITHUB_REPO=owner/repo
#GITHUB_APP_ID=
#GITHUB_INSTALLATION_ID=
#GITHUB_APP_PRIVATE_KEY_PATH=/opt/licensehub/app.pem
# 배포 저장소 전용 파인그레인 PAT (Contents: Read and write) — App 대신 사용 가능
#GITHUB_PAT=