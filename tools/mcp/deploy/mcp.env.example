# /etc/licensehub/mcp.env
# 권장 권한: root:licensehub, 640

# LicenseHub 백엔드 주소 (MCP 서버가 호출할 대상)
LICENSEHUB_URL=https://licensehub.example.com

# HTTP 바인딩 (Caddy 가 127.0.0.1:8090 으로 프록시)
MCP_HOST=127.0.0.1
MCP_PORT=8090
MCP_PATH=/mcp

# 인증 필수. 공개 노출 시 절대 0 으로 두지 않는다.
MCP_REQUIRE_AUTH=1

# 원격 모드에서는 클라이언트가 Authorization: Bearer 로 토큰을 보내므로
# LICENSEHUB_TOKEN 을 서버에 고정하지 않는다(관리자 토큰 고정 금지).

# L2 검증 키를 바꿀 때만 사용
# LICENSEHUB_VERIFY_KEY=...
