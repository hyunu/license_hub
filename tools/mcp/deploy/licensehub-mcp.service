[Unit]
Description=LicenseHub MCP HTTP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=licensehub
Group=licensehub
WorkingDirectory=/opt/licensehub/tools/mcp
EnvironmentFile=/etc/licensehub/mcp.env
ExecStart=/usr/bin/node /opt/licensehub/tools/mcp/licensehub-mcp.js --http
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
